{
  "version": 2,
  "regions": [
    "bom1"
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "30 18 * * *"
    }
  ]
}
